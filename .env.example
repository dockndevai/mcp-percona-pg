# --- Connection -------------------------------------------------------------
# The server talks to the Percona Operator through a standard kube-config —
# the same kubeconfig/context you'd use with kubectl against the operator's
# namespaces.
#
# Path to a kube-config file. Leave empty to use default resolution
# (KUBECONFIG env var, then ~/.kube/config).
KUBECONFIG_PATH=
# Load in-cluster credentials (service account) instead of a kube-config file.
PERCONA_IN_CLUSTER=false
# Default context to use when a tool call omits one (empty = current-context).
PERCONA_CONTEXT=
# Default namespace for PerconaPGCluster resources when a tool omits one.
PERCONA_NAMESPACE=postgres-operator

# --- Access mode ------------------------------------------------------------
# read-only  : list/get clusters, status, pooling, backups (default)
# read-write : + scale, tune PgBouncer/PostgreSQL, pause/resume, on-demand backup
# admin      : + restore/PITR, promote standby, upgrade, delete (each still gated below)
PERCONA_MODE=read-only

# --- Scoping ----------------------------------------------------------------
# Comma-separated allowlists (empty = all). Protected clusters are readable but
# never mutated, restored over, or deleted.
PERCONA_NAMESPACE_ALLOWLIST=
PERCONA_CLUSTER_ALLOWLIST=
PERCONA_PROTECTED_CLUSTERS=
PERCONA_CONTEXT_ALLOWLIST=

# --- High-impact opt-ins (all default false / true as noted) ----------------
# Destructive deletes (delete_cluster, delete_backup) need this AND admin mode.
PERCONA_ALLOW_DELETE=false
# Restore / PITR (restore_cluster overwrites data) needs this AND admin mode.
PERCONA_ALLOW_RESTORE=false
# Major-version upgrade (upgrade_cluster) needs this AND admin mode.
PERCONA_ALLOW_UPGRADE=false
# Require echoing the exact cluster name to run delete/restore/promote/upgrade.
PERCONA_REQUIRE_CONFIRMATION=true

# --- Safety / observability -------------------------------------------------
# Validate + log writes without sending them to the cluster.
PERCONA_DRY_RUN=false
# Emit a structured JSON audit line to stderr per guarded operation.
PERCONA_AUDIT_LOG=true
